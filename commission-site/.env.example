# Server-only OAuth configuration. Do not commit real values.
DERIV_APP_ID=your_registered_deriv_application_id
DERIV_REDIRECT_URI=http://localhost:8787/auth/callback
PORT=8787


# The official PKCE exchange documented by Deriv does not require a client secret.
# If Deriv enables confidential-client credentials for your registration later,
# keep that value server-only and follow the dashboard's current instructions.
# DERIV_CLIENT_SECRET=server_only_value